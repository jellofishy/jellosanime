# Copy this file to ".env" and fill in your values. ".env" is ignored by git.
# On Netlify, add the same names under Site settings > Environment variables.

# Supabase login (find both in Supabase > Project Settings > API). These two are public-safe.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Needed from the "Where to watch" step onward. SECRET: never put VITE_ in front of it.
TMDB_API_KEY=
